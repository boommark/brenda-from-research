# Track only the engine: .claude/, CLAUDE.md, README.md, STYLE-GUIDE.md, assets/
/*
!/.gitignore
!/.claude/
!/CLAUDE.md
!/README.md
!/STYLE-GUIDE.md
!/assets/

# never commit vault data, browser dumps, or local state
.DS_Store
.playwright-mcp/
.hyperresearch/
research/
runs/
outputs/

# odin is a separate git repository, not part of this engine
.claude/skills/odin/
